  ],
  "active_windows_exe": "../../release/SWC-2.3.2-selfhost/swc.exe",
  "validation": {
    "active_windows_exe_must_not_be_overwritten": true,
    "required": [
      "shared graph parses",
      "target dispatch resolves exactly one backend",
      "Windows candidate version and compile pass",
      "Linux candidate version and ELF emission pass",
      "selfhost round trip for each target"
    ]
  }
