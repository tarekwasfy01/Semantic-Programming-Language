{
  "schema": "slc.semantic-module.v1",
  "name": "swc-cross",
  "version": "2026.10.02",
  "language": "semantic",
  "entry_point": "compile_program",
  "status": "CANDIDATE",
  "architecture": "x86_64",
  "shared": {
    "source_root": "../source/shared/se",
    "primary": "SLC-transpiler-integrated-frontend12-stringeq.se",
