      "rich semantic reader",
      "frontend and UAST lowering",
      "transpile and target matrix",
      "SMOD resolution and Embed-All",
      "semantic graph merge and rebinding"
    ]
  },
  "targets": [
    {
      "id": "x86_64-windows-pe",
      "kind": "pe",
      "source_root": "../source/windows",
      "entry_source": "se/swc-selfhost-windows.se",
      "delta_root": "windows-delta-reference",
      "status": "reference-integrated"
    },
    {
      "id": "x86_64-linux-elf",
      "kind": "elf",
      "source_root": "../source/linux",
      "entry_source": "integration/SLC-unified-previous-selfhost.se",
      "elf_functions": ["elf_init", "elf_finish", "compile_program", "read_file", "write_file"],
      "status": "reference-integrated"
    }
  ],
  "dependencies": [
    "../source/shared/modules/backend-closure2.smod",
    "../source/shared/modules/backend-closure3.smod",
    "../source/shared/modules/backend-closure4.smod",
    "../source/shared/modules/backend-closure5.smod",
